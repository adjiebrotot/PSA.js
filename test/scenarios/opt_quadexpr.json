{
  "description": "Quadratic expressions: products of variables and single-term expressions (constants give linear cross terms), powers, sums, scaling, mixing with linear expressions and quadratic objectives built from them (LP files and solution).",
  "tolerance": {"rtol": 1e-06, "atol": 1e-06},
  "ops": [
    ["load_example", "ac-dc-meshed"],
    ["set_snapshots", {"$slice": [0, 3]}],
    ["create_model"],
    ["linexpr", "sq_var", {"var": "Generator-p"}, [["mul", [{"$var": "Generator-p"}]]]],
    ["record", "sq_var", "result", "sq_var"],
    ["linexpr", "pow_var", {"var": "Generator-p"}, [["__pow__", [2]]]],
    ["record", "pow_var", "result", "pow_var"],
    ["linexpr", "sq_expr", {"var": "Generator-p"}, [["mul", [2]], ["add", [3]], ["mul", [{"$var": "Generator-p"}]]]],
    ["record", "sq_expr", "result", "sq_expr"],
    ["linexpr", "lin1", {"var": "Generator-p"}, [["mul", [4]], ["add", [-2]]]],
    ["record", "lin1", "result", "lin1"],
    ["linexpr", "prod_consts", {"var": "Generator-p"}, [["mul", [0.5]], ["add", [1]], ["mul", [{"$result": "lin1"}]]]],
    ["record", "prod_consts", "result", "prod_consts"],
    ["linexpr", "cross", {"var": "Generator-p"}, [["mul", [{"$var": "Generator-p_nom"}]]]],
    ["record", "cross", "result", "cross"],
    ["linexpr", "cross_rev", {"var": "Generator-p_nom"}, [["mul", [{"$var": "Generator-p"}]]]],
    ["record", "cross_rev", "result", "cross_rev"],
    ["linexpr", "cross_rev_const", {"var": "Generator-p_nom"}, [["mul", [2]], ["add", [1]], ["mul", [{"$var": "Generator-p"}]]]],
    ["record", "cross_rev_const", "result", "cross_rev_const"],
    ["linexpr", "quad_sel", {"var": "Generator-p"}, [["mul", [{"$var": "Generator-p"}]], ["sel", [], {"name": ["Norway Gas", "Manchester Wind"]}]]],
    ["record", "quad_sel", "result", "quad_sel"],
    ["linexpr", "quad_sum", {"var": "Generator-p"}, [["mul", [{"$var": "Generator-p"}]], ["sum"]]],
    ["record", "quad_sum", "result", "quad_sum"],
    ["linexpr", "quad_sum_dim", {"var": "Generator-p"}, [["mul", [{"$var": "Generator-p"}]], ["sum", ["name"]]]],
    ["record", "quad_sum_dim", "result", "quad_sum_dim"],
    ["linexpr", "quad_scale", {"var": "Generator-p"}, [["mul", [{"$var": "Generator-p"}]], ["mul", [3]]]],
    ["record", "quad_scale", "result", "quad_scale"],
    ["linexpr", "quad_plus_lin", {"var": "Generator-p"}, [["mul", [{"$var": "Generator-p"}]], ["add", [{"$var": "Generator-p"}]]]],
    ["record", "quad_plus_lin", "result", "quad_plus_lin"],
    ["linexpr", "lin_plus_quad", {"var": "Generator-p"}, [["mul", [2]], ["add", [{"$result": "sq_var"}]]]],
    ["record", "lin_plus_quad", "result", "lin_plus_quad"],
    ["linexpr", "quad_plus_quad", {"var": "Generator-p"}, [["mul", [{"$var": "Generator-p"}]], ["add", [{"$result": "cross"}]]]],
    ["record", "quad_plus_quad", "result", "quad_plus_quad"],
    ["linexpr", "quad_minus", {"var": "Generator-p"}, [["mul", [{"$var": "Generator-p"}]], ["sub", [{"$result": "lin1"}]]]],
    ["record", "quad_minus", "result", "quad_minus"],
    ["linexpr", "quad_plus_const", {"var": "Generator-p"}, [["mul", [{"$var": "Generator-p"}]], ["add", [7]]]],
    ["record", "quad_plus_const", "result", "quad_plus_const"],
    ["linexpr", "quad_neg", {"var": "Generator-p"}, [["mul", [{"$var": "Generator-p"}]], ["__neg__"]]],
    ["record", "quad_neg", "result", "quad_neg"],
    ["linexpr", "obj1", {"var": "Generator-p"}, [["mul", [{"$var": "Generator-p"}]], ["mul", [0.01]], ["sum"]]],
    ["set_objective", "obj1", {"add": true}],
    ["record", "lp_add", "model_lp"],
    ["call", "optimize.solve_model"],
    ["record", "objective_add", "path", ["objective"]],
    ["linexpr", "obj2", {"var": "Generator-p"}, [["mul", [{"$var": "Generator-p_nom"}]], ["mul", [0.001]], ["sum"]]],
    ["set_objective", "obj2", {}],
    ["record", "lp_cross", "model_lp"]
  ]
}
