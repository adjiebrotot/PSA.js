    ["add", "GlobalConstraint", "battery_limit", {"type": "operational_limit", "carrier_attribute": "battery", "sense": "<=", "constant": 5000}],
    ["set_static_all", "StorageUnit", "state_of_charge_initial", 1000],
    ["set_static_all", "StorageUnit", "p_nom_extendable", true],
    ["set_static_all", "StorageUnit", "cyclic_state_of_charge", false],
    ["record", "oplimit_hvdc_lp", "lp", {}],
    ["call", "optimize", [], {}, "oplimit_hvdc_status"],
    ["record", "oplimit_hvdc_status", "result", "oplimit_hvdc_status"],
    ["record", "oplimit_hvdc_objective", "path", ["objective"]],
    ["record", "oplimit_hvdc_network", "network"]
