    ["record", "quadratic_network", "network"],
    ["load_example", "ac-dc-meshed"],
    ["remove", "GlobalConstraint", "co2_limit"],
    ["add", "GlobalConstraint", "gas_limit", {"type": "operational_limit", "carrier_attribute": "gas", "sense": "<=", "constant": 30000}],
