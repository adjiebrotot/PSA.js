    ["add", "StorageUnit", "storage", {"bus": "bus", "p_nom": 50, "max_hours": 2, "p_set": [-10, 0, 5, 0], "state_of_charge_initial": 10}],
    ["record", "su_p_set_lp", "lp", {}],
    ["call", "optimize", [], {}, "su_p_set_status"],
    ["record", "su_p_set_status", "result", "su_p_set_status"],
