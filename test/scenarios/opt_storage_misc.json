    ["add", "Load", "load", {"bus": "bus", "p_set": [20, 30, 25, 35]}],
    ["add", "Store", "store", {"bus": "bus", "e_nom": 100, "p_set": [-10, 0, 5, 0], "e_initial": 10}],
    ["record", "store_p_set_lp", "lp", {}],
    ["call", "optimize", [], {}, "store_p_set_status"],
    ["record", "store_p_set_status", "result", "store_p_set_status"],
    ["record", "store_p_set_objective", "path", ["objective"]],
    ["record", "store_p_set_network", "network"],
    ["new_network"],
    ["set_snapshots", [0, 1, 2, 3]],
    ["add", "Bus", ["a", "b"]],
    ["add", "Line", "ab", {"bus0": "a", "bus1": "b", "x": 0.1, "s_nom": 60}],
    ["add", "Generator", ["g1", "g2", "g3"], {"bus": ["a", "a", "b"], "p_nom": [100, 80, 50], "marginal_cost": [10, 20, 30], "marginal_cost_quadratic": [0.1, 0.05, 0.2]}],
