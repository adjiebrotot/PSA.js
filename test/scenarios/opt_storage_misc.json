    ["add", "Load", ["la", "lb"], {"bus": ["a", "b"], "p_set": {"$frame": {"columns": ["la", "lb"], "data": [[50, 40], [80, 60], [30, 90], [60, 20]]}}}],
    ["add", "Store", "s", {"bus": "b", "e_nom": 50, "marginal_cost_quadratic": 0.01, "e_cyclic": true}],
    ["record", "quadratic_lp", "lp", {}],
    ["call", "optimize", [], {}, "quadratic_status"],
    ["record", "quadratic_status", "result", "quadratic_status"],
