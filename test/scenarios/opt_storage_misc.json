    ["add", "StorageUnit", "hydro", {"bus": "bus", "p_nom": 100, "max_hours": 10, "inflow": [200, 200, 200, 200, 200, 50, 50, 50, 50, 50], "spill_cost": 1}],
    ["add", "Load", "load", {"bus": "bus", "p_set": [100, 100, 100, 100, 100, 100, 100, 100, 100, 100]}],
    ["record", "spill_cost_lp0", "lp", {"snapshots": {"$slice": [0, 7]}}],
