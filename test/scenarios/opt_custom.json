{
  "description": "Custom constraints and variables added to the model (linopy expression API) and dual assignment (from PyPSA test_lopf_global_constraints.py).",
  "ops": [
    ["load_example", "ac-dc-meshed"],
    ["create_model", {}],
    ["add_constraint", "Link-p", "all", "<=", 30000, "GlobalConstraint-generation_limit"],
    ["add_constraint", "Link-p", "name", "<=", 30000, "GlobalConstraint-generation_limit_dynamic"],
    ["solve_model", {"assign_all_duals": true}, "assign_True_status"],
    ["record", "assign_True_status", "result", "assign_True_status"],
    ["record", "assign_True_objective", "path", ["objective"]],
    ["record", "assign_True_network", "network"],
    ["load_example", "ac-dc-meshed"],
    ["create_model", {}],
    ["add_constraint", "Link-p", "all", "<=", 30000, "GlobalConstraint-generation_limit"],
    ["add_constraint", "Link-p", "name", "<=", 30000, "GlobalConstraint-generation_limit_dynamic"],
    ["solve_model", {"assign_all_duals": false}, "assign_False_status"],
    ["record", "assign_False_status", "result", "assign_False_status"],
    ["record", "assign_False_objective", "path", ["objective"]],
    ["record", "assign_False_network", "network"],
    ["load_example", "ac-dc-meshed"],
    ["create_model", {}],
    ["add_constraint", "Generator-p_nom", "all", "==", 10000, "GlobalConstraint-investment_limit"],
    ["solve_model", {"assign_all_duals": true}, "noname_status"],
    ["record", "noname_objective", "path", ["objective"]],
    ["record", "noname_gc", "path", ["c", "global_constraints", "static"]],
    ["load_example", "ac-dc-meshed"],
    ["create_model", {}],
    ["add_variable", "custom_var"],
    ["add_constraint", "Generator-p", {"sel": {"name": ["Manchester Wind", "Norway Wind"]}, "sum": ["snapshot", "name"]}, ">=", 1000, "custom_wind"],
    ["add_constraint", "Line-s", {"sel": {"snapshot": {"$slice": [0, 3]}}, "sum": null}, "<=", 400, "Line-custom_cap"],
    ["record", "custom_lp", "model_lp"],
    ["solve_model", {}, "custom_status"],
    ["record", "custom_objective", "path", ["objective"]],
    ["record", "custom_network", "network"]
  ],
  "tolerance": {"rtol": 1e-06, "atol": 1e-06}
}
