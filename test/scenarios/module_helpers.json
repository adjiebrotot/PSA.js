{
  "description": "pypsa.costs (annuity, periodized_cost on numbers and Series) and pypsa.geo (haversine_pts, haversine, compute_bbox)",
  "ops": [
    ["new_network"],
    ["call_module", "costs.annuity", [0.07, 25], {}, "ann_scalar"],
    ["call_module", "costs.annuity", [0, 20], {}, "ann_zero"],
    ["call_module", "costs.annuity", [-0.02, 20], {}, "ann_negative"],
    ["call_module", "costs.annuity", [0.05, {"$float": "inf"}], {}, "ann_inf"],
    ["call_module", "costs.annuity", [-0.05, {"$float": "inf"}], {}, "ann_inf_negative"],
    ["call_module", "costs.annuity", [0, {"$float": "inf"}], {}, "ann_zero_inf"],
    ["call_module", "costs.annuity", [{"$series": {"index": ["a", "b", "c", "d", "e"], "values": [0.07, 0, {"$float": "nan"}, -0.1, 0.03]}}, {"$series": {"index": ["a", "b", "c", "d", "e"], "values": [25, 10, 5, {"$float": "inf"}, {"$float": "inf"}]}}], {}, "ann_series"],
    ["call_module", "costs.annuity", [{"$series": {"index": ["a", "b", "c"], "values": [0.07, 0, -0.03]}}, 30], {}, "ann_series_rate"],
    ["call_module", "costs.annuity", [{"$series": {"index": ["a", "b"], "values": [0.07, -0.03]}}, {"$float": "inf"}], {}, "ann_series_rate_inf"],
    ["call_module", "costs.annuity", [0.04, {"$series": {"index": ["x", "y", "z"], "values": [20, 40, {"$float": "inf"}]}}], {}, "ann_series_lifetime"],
    ["call_module", "costs.annuity", [0, {"$series": {"index": ["x", "y"], "values": [20, {"$float": "inf"}]}}], {}, "ann_zero_series_lifetime"],
    ["expect_error", "ann_bad_lifetime", ["call_module", "costs.annuity", [0.07, 0], {}, "x"]],
    ["call_module", "costs.periodized_cost", [0, 1000, 0.07, 25], {}, "pc_overnight"],
    ["call_module", "costs.periodized_cost", [100, {"$float": "nan"}, 0.07, 25], {}, "pc_capital"],
    ["call_module", "costs.periodized_cost", [100, {"$float": "nan"}, 0.07, 25, 12.5], {}, "pc_capital_fom"],
    ["call_module", "costs.periodized_cost", [100, 1000, 0.07, 25, {"$float": "nan"}, 2.0], {}, "pc_overnight_nyears"],
    ["call_module", "costs.periodized_cost", [{"$series": {"index": ["g1", "g2", "g3"], "values": [100, 200, 300]}}, {"$series": {"index": ["g1", "g2", "g3"], "values": [1000, {"$float": "nan"}, 500]}}, {"$series": {"index": ["g1", "g2", "g3"], "values": [0.07, 0.05, 0]}}, {"$series": {"index": ["g1", "g2", "g3"], "values": [25, 30, 20]}}, {"$series": {"index": ["g1", "g2", "g3"], "values": [10, {"$float": "nan"}, 5]}}, {"$series": {"index": [2030, 2040], "values": [10, 10]}}], {}, "pc_series"],
    ["call_module", "costs.periodized_cost", [{"$series": {"index": ["g1", "g2"], "values": [100, 200]}}, {"$series": {"index": ["g1", "g2"], "values": [{"$float": "nan"}, {"$float": "nan"}]}}, 0.07, 25, null, {"$series": {"index": [2030, 2040], "values": [10, 5]}}], {}, "pc_series_capital"],
    ["expect_error", "pc_unequal_nyears", ["call_module", "costs.periodized_cost", [100, 1000, 0.07, 25, null, {"$series": {"index": [2030, 2040], "values": [10, 5]}}], {}, "x"]],
    ["call_module", "costs.periodized_cost", [{"$series": {"index": ["g1", "g2"], "values": [100, 200]}}, 800, {"$series": {"index": ["g1", "g2"], "values": [0.07, 0.02]}}, 25, 3], {}, "pc_scalar_overnight"],
    ["call_module", "geo.haversine_pts", [[[10.1, 52.6], [10.8, 52.1], [-0.13, 51.5]], [[10.8, 52.1], [-34, 56.0], [151.2, -33.9]]], {}, "hav_pts"],
    ["call_module", "geo.haversine_pts", [[10.1, 52.6], [-34, 56.0]], {}, "hav_pts_single"],
    ["call_module", "geo.haversine", [[10.1, 52.6], [[10.8, 52.1], [-34, 56.0]]], {}, "hav_one"],
    ["call_module", "geo.haversine", [[[10.1, 52.6], [0, 0], [179.9, 0]], [[10.8, 52.1], [-34, 56.0], [-179.9, 0], [0, 90]]], {}, "hav_matrix"],
    ["expect_error", "hav_bad_shape", ["call_module", "geo.haversine", [[[1, 2, 3]], [[1, 2]]], {}, "x"]],
    ["call_module", "geo.compute_bbox", [[1, 2, 3], [4, 5, 6]], {}, "bbox"],
    ["call_module", "geo.compute_bbox", [[1.5, {"$float": "nan"}, -3.25, 7], [40.1, 52.0, {"$float": "nan"}, 61.3]], {"margin": 0.1}, "bbox_margin"],
    ["record", "ann_scalar", "result", "ann_scalar"],
    ["record", "ann_zero", "result", "ann_zero"],
    ["record", "ann_negative", "result", "ann_negative"],
    ["record", "ann_inf", "result", "ann_inf"],
    ["record", "ann_inf_negative", "result", "ann_inf_negative"],
    ["record", "ann_zero_inf", "result", "ann_zero_inf"],
    ["record", "ann_series", "result", "ann_series"],
    ["record", "ann_series_rate", "result", "ann_series_rate"],
    ["record", "ann_series_rate_inf", "result", "ann_series_rate_inf"],
    ["record", "ann_series_lifetime", "result", "ann_series_lifetime"],
    ["record", "ann_zero_series_lifetime", "result", "ann_zero_series_lifetime"],
    ["record", "pc_overnight", "result", "pc_overnight"],
    ["record", "pc_capital", "result", "pc_capital"],
    ["record", "pc_capital_fom", "result", "pc_capital_fom"],
    ["record", "pc_overnight_nyears", "result", "pc_overnight_nyears"],
    ["record", "pc_series", "result", "pc_series"],
    ["record", "pc_series_capital", "result", "pc_series_capital"],
    ["record", "pc_scalar_overnight", "result", "pc_scalar_overnight"],
    ["record", "hav_pts", "result", "hav_pts"],
    ["record", "hav_pts_single", "result", "hav_pts_single"],
    ["record", "hav_one", "result", "hav_one"],
    ["record", "hav_matrix", "result", "hav_matrix"],
    ["record", "bbox", "result", "bbox"],
    ["record", "bbox_margin", "result", "bbox_margin"]
  ]
}
