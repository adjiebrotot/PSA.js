{
  "description": "Optimisation workflows: security-constrained LOPF, iterative transmission expansion with discretisation, LOPF followed by non-linear power flow.",
  "ops": [
    ["load_example", "scigrid-de"],
    ["set_static_all", "Generator", "control", "PV"],
    ["set_static_where", "Generator", "control", "bus", "492", "PQ"],
    ["call", "calculate_dependent_values"],
    ["call", "determine_network_topology"],
    ["set_static", "Line", "s_nom", {"316": 1200, "527": 1200, "602": 1200}],
    ["call", "optimize.optimize_security_constrained", [], {"snapshots": {"$slice": [0, 1]}, "branch_outages": ["1", "2"], "assign_all_duals": true}, "sclopf_status"],
    ["record", "sclopf_status", "result", "sclopf_status"],
    ["record", "sclopf_objective", "path", ["objective"]],
    ["record", "sclopf_gen_p", "path", ["c", "generators", "dynamic", "p"]],
    ["record", "sclopf_line_p0", "path", ["c", "lines", "dynamic", "p0"]],
    ["record", "sclopf_mp", "path", ["c", "buses", "dynamic", "marginal_price"]],
    ["new_network"],
    ["add", "Bus", "bus1"],
    ["add", "Bus", "bus2"],
    ["add", "Line", "line1", {"bus0": "bus1", "bus1": "bus2", "x": 0.1}],
    ["add", "Generator", "gen1", {"bus": "bus1", "marginal_cost": 10}],
    ["call", "optimize.optimize_security_constrained", [], {"branch_outages": {"$multiindex": [["Line", "line1"]]}}, "sclopf2_status"],
    ["record", "sclopf2_status", "result", "sclopf2_status"],
    ["record", "sclopf2_network", "network"],
    ["new_network"],
    ["add", "Bus", ["a", "b", "c"], {"v_nom": 380.0}],
    ["add", "Generator", "generator", {"bus": "a", "p_nom": 900.0, "marginal_cost": 10.0}],
    ["add", "Load", "load", {"bus": "c", "p_set": 900.0}],
    ["add", "Line", "ab", {"bus0": "a", "bus1": "b", "x": 0.0001, "s_nom_extendable": true, "capital_cost": 1000}],
    ["add", "Link", "bc", {"bus0": "b", "bus1": "c", "p_nom_extendable": true, "capital_cost": 1000, "carrier": "HVDC"}],
    ["set_static_all", "Line", "s_nom_opt", 1000],
    ["call", "optimize.optimize_transmission_expansion_iteratively", [], {"max_iterations": 1, "line_unit_size": 500, "link_unit_size": {"HVDC": 600}, "link_threshold": {"HVDC": 0.4}}, "iter_status"],
    ["record", "iter_status", "result", "iter_status"],
    ["record", "iter_objective", "path", ["objective"]],
    ["record", "iter_network", "network"],
    ["load_example", "ac-dc-meshed"],
    ["set_static_all", "Line", "s_nom_opt", {"$path": ["c", "lines", "static", "s_nom"]}],
    ["call", "optimize.optimize_transmission_expansion_iteratively", [], {"track_iterations": true, "min_iterations": 2, "max_iterations": 4}, "iter2_status"],
    ["record", "iter2_status", "result", "iter2_status"],
    ["record", "iter2_objective", "path", ["objective"]],
    ["record", "iter2_lines", "path", ["c", "lines", "static"]],
    ["load_example", "scigrid-de"],
    ["set_static_all", "Generator", "control", "PV"],
    ["set_static_where", "Generator", "control", "bus", "492", "PQ"],
    ["call", "calculate_dependent_values"],
    ["call", "determine_network_topology"],
    ["call", "optimize.optimize_and_run_non_linear_powerflow", [], {"snapshots": {"$slice": [0, 4]}}, "lopf_pf"],
    ["record", "lopf_pf_converged", "path", ["c", "buses", "dynamic", "v_mag_pu"]],
    ["record", "lopf_pf_vang", "path", ["c", "buses", "dynamic", "v_ang"]],
    ["record", "lopf_pf_q", "path", ["c", "generators", "dynamic", "q"]]
  ],
  "tolerance": {"rtol": 1e-06, "atol": 1e-06},
  "record_tolerance": {"sclopf_mp": {"rtol": 1e-05, "atol": 0.0001}}
}
