{
  "description": "Building networks with add/remove, snapshots, investment periods, time series and copies.",
  "ops": [
    ["new_network", {"name": "built"}],
    ["set_snapshots", ["t0", "t1", "t2", "t3"]],
    ["add", "Bus", ["b0", "b1", "b2"], {"v_nom": [380, 220, 110], "x": [0.1, 1.5, 2.0], "carrier": "AC"}],
    ["add", "Carrier", ["gas", "wind"], {"co2_emissions": [0.2, 0]}],
    ["add", "Generator", "gas", {"bus": "b0", "p_nom": 100, "marginal_cost": 50, "carrier": "gas"}],
    ["add", "Generator", "wind", {"bus": "b1", "p_nom_extendable": true, "capital_cost": 1000, "p_max_pu": [0.1, 0.5, 0.9, 0.3], "carrier": "wind"}],
    ["add", "Generator", ["g2", "g3"], {"bus": ["b2", "b0"], "p_nom": 10, "custom_attr": [1.5, 2.5]}],
    ["add", "Generator", ["ts1", "ts2"], {"bus": "b2", "p_set": {"$frame": {"columns": ["ts1", "ts2"], "data": [[1, 2], [3, 4], [5, 6], [7, 8]]}}}],
    ["add", "Load", "load", {"bus": "b2", "p_set": [10, 20, 30, 40], "q_set": 5}],
    ["add", "Line", ["l0", "l1"], {"bus0": ["b0", "b1"], "bus1": ["b1", "b2"], "x": 0.1, "r": 0.01, "s_nom": 100}],
    ["add", "Link", "hvdc", {"bus0": "b0", "bus1": "b2", "bus2": "b1", "efficiency": 0.9, "efficiency2": 0.05, "p_nom": 50}],
    ["add", "StorageUnit", "battery", {"bus": "b1", "max_hours": 4, "p_nom": 20, "inflow": [0, 1, 2, 3]}],
    ["add", "Store", "h2", {"bus": "b2", "e_nom": 100, "e_cyclic": true}],
    ["add", "Generator", "suffixed", {"bus": "b0"}, {"suffix": " new"}],
    ["add", "Generator", "gas", {"bus": "b1", "p_nom": 999}],
    ["add", "Generator", "g3", {"bus": "b1", "p_nom": 77}, {"overwrite": true}],
    ["record", "after_add", "network"],
    ["remove", "Generator", "g2"],
    ["remove", "Line", ["l1"]],
    ["record", "after_remove", "network"],
    ["set_snapshots", ["t0", "t1", "t9"]],
    ["record", "after_resnapshot", "network"],
    ["set_investment_periods", [2020, 2030]],
    ["record", "after_periods", "network"],
    ["record", "nyears", "path", ["nyears"]],
    ["copy"],
    ["record", "copy", "network"]
  ]
}
