{
  "description": "Stochastic networks (set_scenarios): broadcasting of static and time-varying data to (scenario, name), scenario-specific values, add/remove after setting scenarios, descriptors, get_scenario, copies and invalid inputs.",
  "ops": [
    ["load_example", "ac-dc-meshed"],
    ["set_snapshots", {"$slice": [0, 4]}],
    ["expect_error", "err_risk_without_scenarios", ["call", "set_risk_preference", [], {"alpha": 0.9, "omega": 0.5}]],
    ["expect_error", "err_sum", ["call", "set_scenarios", [{"low": 0.3, "high": 0.6}]]],
    ["call", "set_scenarios", [{"low": 0.3, "high": 0.7}]],
    ["expect_error", "err_twice", ["call", "set_scenarios", [{"a": 0.5, "b": 0.5}]]],
    ["record", "broadcast", "network"],
    ["record", "scenarios", "path", ["scenarios"]],
    ["record", "weightings", "path", ["scenario_weightings"]],
    ["record", "has_scenarios", "path", ["has_scenarios"]],
    ["record", "gen_names", "path", ["c", "generators", "names"]],
    ["record", "gen_extendables", "path", ["c", "generators", "extendables"]],
    ["record", "line_fixed", "path", ["c", "lines", "fixed"]],
    ["record", "gen_active", "path", ["c", "generators", "active_assets"]],
    ["record", "gen_inactive", "path", ["c", "generators", "inactive_assets"]],
    ["set_static_sc", "generators", "marginal_cost", "high", {"Manchester Gas": 40, "Frankfurt Gas": 55}],
    ["set_static_sc", "lines", "s_nom", "low", {"0": 500}],
    ["set_dynamic_sc", "generators", "p_max_pu", "high", {"Manchester Wind": [0.1, 0.2, 0.3, 0.4]}],
    ["set_dynamic_sc", "loads", "p_set", "low", {"London": [100, 200, 300, 400]}],
    ["add", "Bus", "extra", {"carrier": "AC", "v_nom": 380}],
    ["add", "Generator", "extra gen", {"bus": "extra", "p_nom": 50, "marginal_cost": 5, "p_max_pu": [0.5, 0.6, 0.7, 0.8]}],
    ["add", "Load", ["extra load", "extra load 2"], {"bus": "extra", "p_set": 10}],
    ["add", "Line", "extra line", {"bus0": "extra", "bus1": "London", "x": 0.1, "s_nom": 100}],
    ["remove", "Generator", "Norway Gas"],
    ["remove", "Load", "extra load 2"],
    ["record", "modified", "network"],
    ["record", "dense_p_max_pu", "path", [["get_switchable_as_dense", ["Generator", "p_max_pu"]]]],
    ["record", "dense_marginal_cost", "path", [["get_switchable_as_dense", ["Generator", "marginal_cost"]]]],
    ["call", "set_risk_preference", [], {"alpha": 0.9, "omega": 0.3}],
    ["record", "risk", "path", ["risk_preference"]],
    ["record", "has_risk", "path", ["has_risk_preference"]],
    ["expect_error", "err_alpha", ["call", "set_risk_preference", [], {"alpha": 1.0, "omega": 0.3}]],
    ["expect_error", "err_omega", ["call", "set_risk_preference", [], {"alpha": 0.5, "omega": 1.5}]],
    ["expect_error", "err_unknown_scenario", ["call", "get_scenario", ["medium"]]],
    ["expect_error", "err_cluster", ["call", "cluster.spatial.get_clustering_from_busmap", [{"$series": {"index": ["London"], "values": ["c1"]}}]]],
    ["copy"],
    ["record", "copied", "network"],
    ["record", "copied_weightings", "path", ["scenario_weightings"]],
    ["call_replace", "get_scenario", ["high"]],
    ["record", "high", "network"],
    ["record", "high_has_scenarios", "path", ["has_scenarios"]],
    ["new_network"],
    ["set_snapshots", [0, 1]],
    ["add", "Bus", "b"],
    ["call", "set_scenarios", [["s1", "s2", "s3", "s4"]]],
    ["record", "equal_weights", "path", ["scenario_weightings"]],
    ["record", "empty_components", "network"],
    ["load_example", "ac-dc-meshed"],
    ["set_snapshots", {"$slice": [0, 2]}],
    ["call", "set_scenarios", [{"low": 0.3, "high": 0.7}]],
    ["expect_error", "err_lpf", ["call", "lpf"]],
    ["expect_error", "err_pf", ["call", "pf"]]
  ]
}
