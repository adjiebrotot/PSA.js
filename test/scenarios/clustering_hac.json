{
  "description": "Spatial clustering by hierarchical agglomerative clustering (scikit-learn Ward linkage constrained to connected buses): busmaps of the SciGrid and AC-DC networks without a feature (all buses equally similar) and with coordinates, full trees and early-stopped trees (>= 100 clusters), disconnected graphs, and a clustered network.",
  "ops": [
    ["load_example", "scigrid-de"],
    ["call", "cluster.spatial.busmap_by_hac", [10], {}, "z10"],
    ["record", "scigrid_zero_10", "result", "z10"],
    ["call", "cluster.spatial.busmap_by_hac", [60], {}, "z60"],
    ["record", "scigrid_zero_60", "result", "z60"],
    ["call", "cluster.spatial.busmap_by_hac", [150], {}, "z150"],
    ["record", "scigrid_zero_150", "result", "z150"],
    ["call", "cluster.spatial.busmap_by_hac", [10], {"feature": {"$columns": {"path": ["c", "buses", "static"], "columns": ["x", "y"]}}}, "xy10"],
    ["record", "scigrid_xy_10", "result", "xy10"],
    ["call", "cluster.spatial.busmap_by_hac", [60], {"feature": {"$columns": {"path": ["c", "buses", "static"], "columns": ["x", "y"]}}}, "xy60"],
    ["record", "scigrid_xy_60", "result", "xy60"],
    ["call", "cluster.spatial.busmap_by_hac", [150], {"feature": {"$columns": {"path": ["c", "buses", "static"], "columns": ["x", "y"]}}}, "xy150"],
    ["record", "scigrid_xy_150", "result", "xy150"],
    ["call", "cluster.spatial.busmap_by_hac", [20], {"feature": {"$columns": {"path": ["c", "buses", "static"], "columns": ["x", "y"]}}, "branch_components": ["Line"]}, "xyl"],
    ["record", "scigrid_xy_lines_20", "result", "xyl"],
    ["load_example", "ac-dc-meshed"],
    ["call", "cluster.spatial.busmap_by_hac", [4], {"feature": {"$columns": {"path": ["c", "buses", "static"], "columns": ["x", "y"]}}}, "acdc4"],
    ["record", "acdc_xy_4", "result", "acdc4"],
    ["call", "cluster.spatial.busmap_by_hac", [3], {"feature": {"$columns": {"path": ["c", "buses", "static"], "columns": ["x", "y"]}}, "branch_components": ["Line"]}, "acdc3"],
    ["record", "acdc_xy_lines_3", "result", "acdc3"],
    ["call", "cluster.spatial.busmap_by_hac", [5], {}, "acdc5"],
    ["record", "acdc_zero_5", "result", "acdc5"],
    ["new_network"],
    ["set_snapshots", [0, 1]],
    ["add", "Bus", ["b0", "b1", "b2", "b3", "b4", "b5", "b6", "b7"], {"x": [0, 1, 0, 1, 5, 6, 5, 9], "y": [0, 0, 1, 1, 5, 5, 6, 9], "v_nom": 380}],
    ["add", "Line", ["l01", "l02", "l13", "l23", "l34", "l45", "l46", "l56", "l57"], {"bus0": ["b0", "b0", "b1", "b2", "b3", "b4", "b4", "b5", "b5"], "bus1": ["b1", "b2", "b3", "b3", "b4", "b5", "b6", "b6", "b7"], "x": 0.1, "s_nom": 100}],
    ["add", "Generator", ["g0", "g5"], {"bus": ["b0", "b5"], "p_nom": [500, 400], "marginal_cost": [10, 20]}],
    ["add", "Load", ["d3", "d6", "d7"], {"bus": ["b3", "b6", "b7"], "p_set": [100, 150, 50]}],
    ["call_replace", "cluster.spatial.cluster_by_hac", [3], {"feature": {"$columns": {"path": ["c", "buses", "static"], "columns": ["x", "y"]}}, "line_length_factor": 1.1}],
    ["record", "small_clustered_3", "network"]
  ]
}
