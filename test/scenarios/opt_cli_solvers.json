{
  "description": "Command-line solvers CBC and GLPK (linopy's CBC/GLPK classes): the LP file is solved by the executables and their solution files are parsed like linopy (values at the printed precision), LP and MILP, solver options, infeasibility, PyPSA's log_to_console option passed on to the solver (glpsol rejects it, linopy then fails on the empty solution file), quadratic objectives rejected.",
  "requires": ["cbc", "glpsol"],
  "ops": [
    ["set_option", "params.optimize.log_to_console", null],
    ["load_example", "ac-dc-meshed"],
    ["call", "optimize", [], {"solver_name": "cbc"}, "acdc_cbc_status"],
    ["record", "acdc_cbc_status", "result", "acdc_cbc_status"],
    ["record", "acdc_cbc_objective", "path", ["objective"]],
    ["record", "acdc_cbc_network", "network"],
    ["load_example", "ac-dc-meshed"],
    ["call", "optimize", [], {"solver_name": "glpk"}, "acdc_glpk_status"],
    ["record", "acdc_glpk_status", "result", "acdc_glpk_status"],
    ["record", "acdc_glpk_objective", "path", ["objective"]],
    ["record", "acdc_glpk_network", "network"],
    ["load_example", "storage-hvdc"],
    ["call", "optimize", [], {"solver_name": "cbc", "solver_options": {"sec": 100, "ratioGap": 0.0}}, "hvdc_cbc_status"],
    ["record", "hvdc_cbc_status", "result", "hvdc_cbc_status"],
    ["record", "hvdc_cbc_objective", "path", ["objective"]],
    ["record", "hvdc_cbc_network", "network"],
    ["load_example", "storage-hvdc"],
    ["call", "optimize", [], {"solver_name": "glpk", "solver_options": {"tmlim": 100}}, "hvdc_glpk_status"],
    ["record", "hvdc_glpk_status", "result", "hvdc_glpk_status"],
    ["record", "hvdc_glpk_objective", "path", ["objective"]],
    ["record", "hvdc_glpk_network", "network"],
    ["new_network"],
    ["set_snapshots", [0, 1, 2, 3]],
    ["add", "Bus", "bus"],
    ["add", "Generator", "coal", {"bus": "bus", "committable": true, "p_min_pu": 0.3, "marginal_cost": 20, "p_nom": 10000}],
    ["add", "Generator", "gas", {"bus": "bus", "committable": true, "marginal_cost": 70, "p_min_pu": 0.1, "p_nom": 1000, "start_up_cost": 50}],
    ["add", "Load", "load", {"bus": "bus", "p_set": [4000, 6000, 5000, 800]}],
    ["save_network", "uc"],
    ["call", "optimize", [], {"solver_name": "cbc"}, "uc_cbc_status"],
    ["record", "uc_cbc_status", "result", "uc_cbc_status"],
    ["record", "uc_cbc_objective", "path", ["objective"]],
    ["record", "uc_cbc_network", "network"],
    ["new_network"],
    ["set_snapshots", [0, 1, 2, 3]],
    ["add", "Bus", "bus"],
    ["add", "Generator", "coal", {"bus": "bus", "committable": true, "p_min_pu": 0.3, "marginal_cost": 20, "p_nom": 10000}],
    ["add", "Generator", "gas", {"bus": "bus", "committable": true, "marginal_cost": 70, "p_min_pu": 0.1, "p_nom": 1000, "start_up_cost": 50}],
    ["add", "Load", "load", {"bus": "bus", "p_set": [4000, 6000, 5000, 800]}],
    ["call", "optimize", [], {"solver_name": "glpk"}, "uc_glpk_status"],
    ["record", "uc_glpk_status", "result", "uc_glpk_status"],
    ["record", "uc_glpk_objective", "path", ["objective"]],
    ["record", "uc_glpk_network", "network"],
    ["new_network"],
    ["set_snapshots", [0, 1]],
    ["add", "Bus", "bus"],
    ["add", "Generator", "gen", {"bus": "bus", "p_nom": 10, "marginal_cost": 5}],
    ["add", "Load", "load", {"bus": "bus", "p_set": 100}],
    ["call", "optimize", [], {"solver_name": "cbc"}, "infeasible_cbc_status"],
    ["record", "infeasible_cbc_status", "result", "infeasible_cbc_status"],
    ["call", "optimize", [], {"solver_name": "glpk"}, "infeasible_glpk_status"],
    ["record", "infeasible_glpk_status", "result", "infeasible_glpk_status"],
    ["add", "Generator", "quad", {"bus": "bus", "p_nom": 200, "marginal_cost": 1, "marginal_cost_quadratic": 0.1}],
    ["expect_error", "quadratic_cbc", ["call", "optimize", [], {"solver_name": "cbc"}]],
    ["remove", "Generator", ["quad"]],
    ["add", "Generator", "peak", {"bus": "bus", "p_nom": 200, "marginal_cost": 50}],
    ["set_option", "params.optimize.log_to_console", false],
    ["call", "optimize", [], {"solver_name": "cbc"}, "log_cbc_status"],
    ["record", "log_cbc_status", "result", "log_cbc_status"],
    ["record", "log_cbc_objective", "path", ["objective"]],
    ["expect_error", "log_glpk", ["call", "optimize", [], {"solver_name": "glpk"}]]
  ]
}
