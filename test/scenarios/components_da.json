{
  "description": "Component views as labelled arrays (PyPSA's xarray accessor c.da and c.ds): static (name) and time-varying (snapshot, name) attributes, the activity mask, strings and booleans, multi-period snapshots, stochastic networks ((snapshot, scenario, name), (scenario, name), the mask (scenario, name, snapshot) or snapshot-major after adding components), and every variable of c.ds.",
  "ops": [
    ["load_example", "ac-dc-meshed"],
    ["record", "gen_p_nom", "dataarray", ["c", "generators", "da", "p_nom"]],
    ["record", "gen_p_max_pu", "dataarray", ["c", "generators", "da", "p_max_pu"]],
    ["record", "gen_marginal_cost", "dataarray", ["c", "generators", "da", "marginal_cost"]],
    ["record", "gen_active", "dataarray", ["c", "generators", "da", "active"]],
    ["record", "gen_bus", "dataarray", ["c", "generators", "da", "bus"]],
    ["record", "gen_extendable", "dataarray", ["c", "generators", "da", "p_nom_extendable"]],
    ["record", "line_s_max_pu", "dataarray", ["c", "lines", "da", "s_max_pu"]],
    ["record", "gen_ds", "dataarray", ["c", "generators", "ds"]],
    ["record", "link_ds", "dataarray", ["c", "links", "ds"]],
    ["expect_error", "gen_unknown", ["record", "x", "dataarray", ["c", "generators", "da", "nope"]]],
    ["call", "optimize"],
    ["record", "gen_p_solved", "dataarray", ["c", "generators", "da", "p"]],
    ["record", "gen_ds_solved", "dataarray", ["c", "generators", "ds"]],
    ["load_example", "ac-dc-meshed"],
    ["set_investment_periods", [2020, 2030]],
    ["set_static", "Generator", "build_year", {"Manchester Gas": 2030}],
    ["set_static", "Generator", "lifetime", {"Norway Gas": 5}],
    ["record", "multi_p_max_pu", "dataarray", ["c", "generators", "da", "p_max_pu"]],
    ["record", "multi_active", "dataarray", ["c", "generators", "da", "active"]],
    ["load_example", "ac-dc-meshed"],
    ["call", "set_scenarios", [{"low": 0.4, "high": 0.6}]],
    ["set_static_sc", "Generator", "marginal_cost", "high", {"Frankfurt Gas": 120.0}],
    ["set_dynamic_sc", "Generator", "p_max_pu", "high", {"Manchester Wind": 0.25}],
    ["record", "sc_p_max_pu", "dataarray", ["c", "generators", "da", "p_max_pu"]],
    ["record", "sc_marginal_cost", "dataarray", ["c", "generators", "da", "marginal_cost"]],
    ["record", "sc_bus", "dataarray", ["c", "generators", "da", "bus"]],
    ["record", "sc_active", "dataarray", ["c", "generators", "da", "active"]],
    ["record", "sc_ds", "dataarray", ["c", "generators", "ds"]],
    ["add", "Generator", "zzz new", {"bus": "Manchester", "p_nom": 10, "p_max_pu": 0.5, "marginal_cost": 3}],
    ["add", "Generator", "aaa new", {"bus": "Frankfurt", "p_nom": 5}],
    ["record", "sc_added_active", "dataarray", ["c", "generators", "da", "active"]],
    ["record", "sc_added_p_max_pu", "dataarray", ["c", "generators", "da", "p_max_pu"]],
    ["record", "sc_added_p_nom", "dataarray", ["c", "generators", "da", "p_nom"]]
  ]
}
