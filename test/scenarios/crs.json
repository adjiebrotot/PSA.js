{
  "description": "Coordinate reference systems: to_crs between WGS 84, LAEA Europe (3035), Pseudo-Mercator (3857) and UTM (ETRS89 / WGS 84 zones 32 and 33) for shape geometries and bus coordinates (PyPSA transforms the buses in each CRS's axis order, which swaps them), the CRS WKT and setting srid (only to the current CRS; a different one raises like PyPSA).",
  "tolerance": {"rtol": 1e-10, "atol": 1e-08},
  "ops": [
    ["load_network", "shapes"],
    ["call", "to_crs", [3035]],
    ["record", "shapes_3035", "network"],
    ["record", "shapes_3035_wkt", "path", ["crs", ["to_wkt"]]],
    ["record", "shapes_3035_srid", "path", ["srid"]],
    ["call", "to_crs", [4326]],
    ["record", "shapes_back_4326", "network"],
    ["call", "to_crs", ["EPSG:3857"]],
    ["record", "shapes_3857", "network"],
    ["call", "to_crs", [25832]],
    ["record", "shapes_25832", "network"],
    ["record", "shapes_25832_wkt", "path", ["crs", ["to_wkt"]]],
    ["load_example", "ac-dc-meshed"],
    ["call", "to_crs", [3857]],
    ["record", "acdc_3857", "network"],
    ["call", "to_crs", [32633]],
    ["record", "acdc_32633", "network"],
    ["load_example", "ac-dc-meshed"],
    ["set_attr", "srid", 4326],
    ["record", "acdc_srid_4326_wkt", "path", ["crs", ["to_wkt"]]],
    ["expect_error", "acdc_srid_change", ["set_attr", "srid", 3035]]
  ]
}
