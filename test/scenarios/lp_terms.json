{
  "description": "linopy's `_term` dimension size of every constraint (PSA.js `termCount`), which decides how the LP writer slices large blocks: nodal balances, compacted KVL rows with lines, transformers and optimised phase shifts, multi-period KVL.",
  "ops": [
    ["load_example", "ac-dc-meshed"],
    ["record", "acdc", "model_terms"],
    ["load_example", "scigrid-de"],
    ["set_snapshots", {"$slice": [0, 2]}],
    ["record", "scigrid", "model_terms"],
    ["load_example", "storage-hvdc"],
    ["record", "storage_hvdc", "model_terms"],
    ["new_network"],
    ["set_snapshots", [0, 1, 2]],
    ["add", "Carrier", "AC"],
    ["add", "Bus", ["A", "B", "C"], {"v_nom": 1.0, "carrier": "AC"}],
    ["add", "Generator", "gen_A", {"bus": "A", "p_nom": 300, "marginal_cost": 10.0, "carrier": "AC"}],
    ["add", "Generator", "gen_C", {"bus": "C", "p_nom": 100, "marginal_cost": 30.0, "carrier": "AC"}],
    ["add", "Load", "load_B", {"bus": "B", "p_set": [150.0, 120.0, 90.0]}],
    ["add", "Line", "L1", {"bus0": "A", "bus1": "B", "x": 0.01, "r": 1e-06, "s_nom": 200, "carrier": "AC"}],
    ["add", "Line", "L2", {"bus0": "B", "bus1": "C", "x": 0.02, "r": 1e-06, "s_nom": 200, "carrier": "AC"}],
    ["add", "Line", "L3", {"bus0": "A", "bus1": "C", "x": 0.015, "r": 1e-06, "s_nom": 200, "carrier": "AC"}],
    ["add", "Transformer", "T1", {"bus0": "A", "bus1": "B", "x": 1.0, "r": 1e-06, "s_nom": 100, "phase_shift_min": -15.0, "phase_shift_max": 5.0, "v_ang_max": 25.0}],
    ["add", "Transformer", "T2", {"bus0": "C", "bus1": "A", "x": 2.0, "r": 1e-06, "s_nom": 100, "phase_shift": 3.0, "v_ang_max": 40.0}],
    ["set_static", "Line", "v_ang_max", {"L1": 23.75}],
    ["record", "phase_shift_optimised", "model_terms"],
    ["new_network"],
    ["set_snapshots", [0, 1]],
    ["set_investment_periods", [2020, 2030]],
    ["add", "Carrier", "AC"],
    ["add", "Bus", ["A", "B", "C"], {"v_nom": 1.0, "carrier": "AC"}],
    ["add", "Generator", "gen_A", {"bus": "A", "p_nom": 300, "marginal_cost": 10.0, "carrier": "AC"}],
    ["add", "Generator", "gen_C", {"bus": "C", "p_nom": 100, "marginal_cost": 30.0, "carrier": "AC"}],
    ["add", "Load", "load_B", {"bus": "B", "p_set": 120.0}],
    ["add", "Line", "L1", {"bus0": "A", "bus1": "B", "x": 0.01, "r": 1e-06, "s_nom": 200, "carrier": "AC"}],
    ["add", "Line", "L2", {"bus0": "B", "bus1": "C", "x": 0.02, "r": 1e-06, "s_nom": 200, "carrier": "AC"}],
    ["add", "Line", "L3", {"bus0": "A", "bus1": "C", "x": 0.015, "r": 1e-06, "s_nom": 200, "carrier": "AC"}],
    ["add", "Transformer", "T1", {"bus0": "A", "bus1": "B", "x": 1.0, "r": 1e-06, "s_nom": 100, "phase_shift": 8.0, "build_year": 2030, "lifetime": 40}],
    ["add", "Transformer", "T2", {"bus0": "A", "bus1": "B", "x": 1.5, "r": 1e-06, "s_nom": 100, "phase_shift_min": -10.0, "phase_shift_max": 10.0, "build_year": 2020, "lifetime": 40}],
    ["record", "phase_shift_multi", "model_terms", {"multi_investment_periods": true}]
  ]
}
