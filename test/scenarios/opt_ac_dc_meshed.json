{
  "description": "Linear optimal power flow / capacity expansion of the ac-dc-meshed example (default options).",
  "ops": [
    ["load_example", "ac-dc-meshed"],
    ["record", "lp", "lp"],
    ["call", "optimize", [], {}, "status"],
    ["record", "status", "result", "status"],
    ["record", "objective", "path", ["objective"]],
    ["record", "objective_constant", "path", ["objective_constant"]],
    ["record", "network", "network"]
  ],
  "tolerance": {"rtol": 1e-6, "atol": 1e-6}
}
