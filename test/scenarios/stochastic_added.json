{
  "description": "Stochastic networks with components added after set_scenarios (their static rows are appended per scenario, so the data is no longer scenario-major): statistic expressions, a constraint built from them, and statistics of the solved network, grouped and ungrouped.",
  "tolerance": {"rtol": 1e-06, "atol": 1e-06},
  "ops": [
    ["load_example", "ac-dc-meshed"],
    ["set_snapshots", {"$slice": [0, 3]}],
    ["call", "set_scenarios", [{"low": 0.3, "high": 0.7}]],
    ["add", "Generator", ["Extra Gas", "Extra Wind"], {"bus": ["London", "Frankfurt"], "carrier": ["gas", "wind"], "p_nom_extendable": true, "capital_cost": [900, 1100], "marginal_cost": [45, 0], "p_max_pu": 0.7}],
    ["add", "Store", "London Store", {"bus": "London", "e_nom_extendable": true, "capital_cost": 50, "e_cyclic": true, "carrier": "AC"}],
    ["add", "Load", "Bremen extra", {"bus": "Bremen", "p_set": [50, 60, 70], "carrier": "AC"}],
    ["set_static_sc", "generators", "marginal_cost", "high", {"Extra Gas": 70, "Manchester Gas": 60}],
    ["create_model"],
    ["expression", "expr_00_capex", "capex", {}],
    ["record", "expr_00_capex", "result", "expr_00_capex"],
    ["expression", "expr_01_capex", "capex", {"groupby": false}],
    ["record", "expr_01_capex", "result", "expr_01_capex"],
    ["expression", "expr_02_capacity", "capacity", {"groupby": false}],
    ["record", "expr_02_capacity", "result", "expr_02_capacity"],
    ["expression", "expr_03_opex", "opex", {}],
    ["record", "expr_03_opex", "result", "expr_03_opex"],
    ["expression", "expr_04_opex", "opex", {"groupby": false}],
    ["record", "expr_04_opex", "result", "expr_04_opex"],
    ["expression", "expr_05_opex", "opex", {"groupby_time": false}],
    ["record", "expr_05_opex", "result", "expr_05_opex"],
    ["expression", "expr_06_supply", "supply", {"groupby": false}],
    ["record", "expr_06_supply", "result", "expr_06_supply"],
    ["expression", "expr_07_withdrawal", "withdrawal", {"groupby": false}],
    ["record", "expr_07_withdrawal", "result", "expr_07_withdrawal"],
    ["expression", "expr_08_energy_balance", "energy_balance", {}],
    ["record", "expr_08_energy_balance", "result", "expr_08_energy_balance"],
    ["expression", "expr_09_energy_balance", "energy_balance", {"groupby": false}],
    ["record", "expr_09_energy_balance", "result", "expr_09_energy_balance"],
    ["expression", "expr_10_energy_balance", "energy_balance", {"components": "Store", "groupby": false, "groupby_time": false}],
    ["record", "expr_10_energy_balance", "result", "expr_10_energy_balance"],
    ["expression", "expr_11_curtailment", "curtailment", {"groupby": false}],
    ["record", "expr_11_curtailment", "result", "expr_11_curtailment"],
    ["expression", "expr_12_operation", "operation", {"groupby": false, "groupby_time": "sum"}],
    ["record", "expr_12_operation", "result", "expr_12_operation"],
    ["expression", "budget", "capex", {"components": "Generator"}, "all"],
    ["expr_constraint", "budget", "<=", 1000000000.0, "budget"],
    ["record", "lp", "model_lp"],
    ["solve_model", {}],
    ["record", "objective", "path", ["objective"]],
    ["record", "stat_00_capex", "path", ["statistics", ["capex", [], {}]]],
    ["record", "stat_01_capex", "path", ["statistics", ["capex", [], {"groupby": false}]]],
    ["record", "stat_02_optimal_capacity", "path", ["statistics", ["optimal_capacity", [], {"groupby": false}]]],
    ["record", "stat_03_opex", "path", ["statistics", ["opex", [], {"groupby": false}]]],
    ["record", "stat_04_supply", "path", ["statistics", ["supply", [], {"groupby": false}]]],
    ["record", "stat_05_withdrawal", "path", ["statistics", ["withdrawal", [], {"groupby": false}]]],
    ["record", "stat_06_energy_balance", "path", ["statistics", ["energy_balance", [], {}]]],
    ["record", "stat_07_energy_balance", "path", ["statistics", ["energy_balance", [], {"groupby": false}]]],
    ["record", "stat_08_energy_balance", "path", ["statistics", ["energy_balance", [], {"groupby": false, "groupby_time": false}]]],
    ["record", "stat_09_curtailment", "path", ["statistics", ["curtailment", [], {"groupby": false}]]],
    ["record", "stat_10_capacity_factor", "path", ["statistics", ["capacity_factor", [], {"groupby": false}]]],
    ["record", "stat_11_revenue", "path", ["statistics", ["revenue", [], {"groupby": false}]]],
    ["record", "stat_12_market_value", "path", ["statistics", ["market_value", [], {"groupby": false}]]],
    ["record", "network", "network"]
  ]
}
