{
  "description": "Security-constrained LOPF on multi-period networks (PyPSA v1.4): per-period topology and branch outage factors, sub-network renumbering, single-period naming, invalid outages.",
  "ops": [
    ["new_network"],
    ["set_multi_snapshots", [[2020, 0], [2020, 1], [2030, 0], [2030, 1]]],
    ["set_investment_periods", [2020, 2030]],
    ["add", "Bus", ["a", "b", "c"]],
    ["add", "Line", ["ab", "bc"], {"bus0": ["a", "b"], "bus1": ["b", "c"], "x": 1, "s_nom": 100}],
    ["add", "Line", "ab_old", {"bus0": "a", "bus1": "b", "x": 1, "s_nom": 100, "build_year": 2000, "lifetime": 25}],
    ["add", "Line", "ca", {"bus0": "c", "bus1": "a", "x": 1, "s_nom": 100, "build_year": 2030}],
    ["add", "Line", "future", {"bus0": "b", "bus1": "c", "x": 1, "s_nom": 100, "build_year": 2040}],
    ["add", "Generator", "g", {"bus": "a", "p_nom": 100, "marginal_cost": 1}],
    ["add", "Generator", "g_c", {"bus": "c", "p_nom": 50, "marginal_cost": 20}],
    ["add", "Load", "l", {"bus": "c", "p_set": [10, 60, 40, 90]}],
    ["call", "optimize.optimize_security_constrained", [], {"branch_outages": ["ab", "ab_old", "ca"], "multi_investment_periods": true}, "multi_status"],
    ["record", "multi_status", "result", "multi_status"],
    ["record", "multi_lp", "model_lp"],
    ["record", "multi_network", "network"],
    ["new_network"],
    ["set_multi_snapshots", [[2020, 0], [2020, 1], [2030, 0], [2030, 1]]],
    ["set_investment_periods", [2020, 2030]],
    ["add", "Bus", ["z", "a", "b", "c"]],
    ["add", "Line", ["ab", "bc"], {"bus0": ["a", "b"], "bus1": ["b", "c"], "x": 1, "s_nom": 100}],
    ["add", "Line", "ab_old", {"bus0": "a", "bus1": "b", "x": 1, "s_nom": 100, "build_year": 2000, "lifetime": 25}],
    ["add", "Line", "ca", {"bus0": "c", "bus1": "a", "x": 1, "s_nom": 100, "build_year": 2030}],
    ["add", "Line", "future", {"bus0": "b", "bus1": "c", "x": 1, "s_nom": 100, "build_year": 2040}],
    ["add", "Generator", "g", {"bus": "a", "p_nom": 100, "marginal_cost": 1}],
    ["add", "Generator", "g_c", {"bus": "c", "p_nom": 50, "marginal_cost": 20}],
    ["add", "Load", "l", {"bus": "c", "p_set": [10, 60, 40, 90]}],
    ["add", "Line", "za", {"bus0": "z", "bus1": "a", "x": 1, "s_nom": 100, "build_year": 2030}],
    ["call", "optimize.optimize_security_constrained", [], {"branch_outages": ["ab", "ca"], "multi_investment_periods": true}, "renumber_status"],
    ["record", "renumber_lp", "model_lp"],
    ["record", "renumber_network", "network"],
    ["new_network"],
    ["set_multi_snapshots", [[2020, 0], [2020, 1], [2030, 0], [2030, 1]]],
    ["set_investment_periods", [2020, 2030]],
    ["add", "Bus", ["a", "b", "c"]],
    ["add", "Line", ["ab", "bc"], {"bus0": ["a", "b"], "bus1": ["b", "c"], "x": 1, "s_nom": 100}],
    ["add", "Line", "ab_old", {"bus0": "a", "bus1": "b", "x": 1, "s_nom": 100, "build_year": 2000, "lifetime": 25}],
    ["add", "Line", "ca", {"bus0": "c", "bus1": "a", "x": 1, "s_nom": 100, "build_year": 2030}],
    ["add", "Line", "future", {"bus0": "b", "bus1": "c", "x": 1, "s_nom": 100, "build_year": 2040}],
    ["add", "Generator", "g", {"bus": "a", "p_nom": 100, "marginal_cost": 1}],
    ["add", "Generator", "g_c", {"bus": "c", "p_nom": 50, "marginal_cost": 20}],
    ["add", "Load", "l", {"bus": "c", "p_set": [10, 60, 40, 90]}],
    ["call", "optimize.optimize_security_constrained", [], {"branch_outages": ["ab", "ca"]}, "single_status"],
    ["record", "single_lp", "model_lp"],
    ["record", "single_network", "network"],
    ["new_network"],
    ["set_multi_snapshots", [[2020, 0], [2020, 1], [2030, 0], [2030, 1]]],
    ["set_investment_periods", [2020, 2030]],
    ["add", "Bus", ["a", "b", "c"]],
    ["add", "Line", ["ab", "bc"], {"bus0": ["a", "b"], "bus1": ["b", "c"], "x": 1, "s_nom": 100}],
    ["add", "Line", "ab_old", {"bus0": "a", "bus1": "b", "x": 1, "s_nom": 100, "build_year": 2000, "lifetime": 25}],
    ["add", "Line", "ca", {"bus0": "c", "bus1": "a", "x": 1, "s_nom": 100, "build_year": 2030}],
    ["add", "Line", "future", {"bus0": "b", "bus1": "c", "x": 1, "s_nom": 100, "build_year": 2040}],
    ["add", "Generator", "g", {"bus": "a", "p_nom": 100, "marginal_cost": 1}],
    ["add", "Generator", "g_c", {"bus": "c", "p_nom": 50, "marginal_cost": 20}],
    ["add", "Load", "l", {"bus": "c", "p_set": [10, 60, 40, 90]}],
    ["expect_error", "inactive_outage", ["call", "optimize.optimize_security_constrained", [], {"branch_outages": ["ab", "future"], "multi_investment_periods": true}]],
    ["expect_error", "unknown_outage", ["call", "optimize.optimize_security_constrained", [], {"branch_outages": {"$multiindex": [["Line", "ab"], ["Line", "typo"]]}, "multi_investment_periods": true}]]
  ],
  "tolerance": {"rtol": 1e-06, "atol": 1e-06}
}
