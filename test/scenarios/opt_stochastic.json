{
  "description": "Stochastic (two-stage) optimisation: LP files and solutions for scenario-specific costs, profiles and loads on the example networks (lines, links, storage units, stores), the CVaR risk-averse objective, unit commitment, multi-period investment, transmission losses and meshed bus thresholds (bus usage counted over all scenarios), quadratic marginal costs, security-constrained optimisation (outage distribution factors of the first scenario) and rolling horizons carrying storage levels per scenario.",
  "tolerance": {"rtol": 1e-06, "atol": 1e-06},
  "ops": [
    ["load_example", "ac-dc-meshed"],
    ["set_snapshots", {"$slice": [0, 4]}],
    ["call", "set_scenarios", [{"low": 0.3, "high": 0.7}]],
    ["set_static_sc", "generators", "marginal_cost", "high", {"Manchester Gas": 40, "Frankfurt Gas": 55}],
    ["set_static_sc", "generators", "capital_cost", "low", {"Norway Wind": 1500}],
    ["set_dynamic_sc", "generators", "p_max_pu", "high", {"Manchester Wind": [0.1, 0.2, 0.3, 0.4]}],
    ["set_dynamic_sc", "loads", "p_set", "low", {"London": [100, 200, 300, 400]}],
    ["record", "acdc_lp", "lp", {"include_objective_constant": true}],
    ["call", "optimize", [], {"include_objective_constant": true}],
    ["record", "acdc", "network"],
    ["record", "acdc_objective", "path", ["objective"]],
    ["record", "acdc_objective_constant", "path", ["objective_constant"]],
    ["record", "acdc_no_const_lp", "lp", {"include_objective_constant": false}],
    ["call", "set_risk_preference", [], {"alpha": 0.9, "omega": 0.5}],
    ["record", "cvar_lp", "lp", {"include_objective_constant": false}],
    ["call", "optimize", [], {"include_objective_constant": false}],
    ["record", "cvar", "network"],
    ["record", "cvar_objective", "path", ["objective"]],
    ["load_example", "storage-hvdc"],
    ["set_snapshots", {"$slice": [0, 4]}],
    ["call", "set_scenarios", [{"dry": 0.25, "normal": 0.5, "wet": 0.25}]],
    ["set_dynamic_sc", "storage_units", "inflow", "wet", {"Storage 0": [5, 5, 5, 5], "Storage 1": [2, 0, 2, 0]}],
    ["set_static_sc", "generators", "marginal_cost", "dry", {"Gas 0": 80, "Gas 3": 90}],
    ["record", "hvdc_lp", "lp", {"include_objective_constant": false}],
    ["call", "optimize", [], {"include_objective_constant": false}],
    ["record", "hvdc", "network"],
    ["record", "hvdc_objective", "path", ["objective"]],
    ["load_example", "model-energy"],
    ["set_snapshots", {"$slice": [0, 6]}],
    ["call", "set_scenarios", [{"volcano": 0.2, "no_volcano": 0.8}]],
    ["set_dynamic_sc", "generators", "p_max_pu", "volcano", {"solar": [0.0, 0.0, 0.01, 0.02, 0.03, 0.01]}],
    ["record", "energy_lp", "lp", {"include_objective_constant": true}],
    ["call", "optimize", [], {"include_objective_constant": true}],
    ["record", "energy", "network"],
    ["record", "energy_objective", "path", ["objective"]],
    ["new_network"],
    ["set_snapshots", [0, 1, 2, 3, 4, 5]],
    ["add", "Bus", "bus"],
    ["add", "Generator", "coal", {"bus": "bus", "committable": true, "p_min_pu": 0.3, "marginal_cost": 20, "p_nom": 10000, "min_up_time": 2, "start_up_cost": 500, "ramp_limit_up": 0.6}],
    ["add", "Generator", "gas", {"bus": "bus", "committable": true, "marginal_cost": 70, "p_min_pu": 0.1, "p_nom": 1000, "min_down_time": 2, "shut_down_cost": 50}],
    ["add", "Generator", "peak", {"bus": "bus", "marginal_cost": 200, "p_nom": 5000}],
    ["add", "Load", "load", {"bus": "bus", "p_set": [4000, 6000, 5000, 800, 3000, 7000]}],
    ["call", "set_scenarios", [{"base": 0.6, "stress": 0.4}]],
    ["set_dynamic_sc", "loads", "p_set", "stress", {"load": [5000, 8000, 7000, 1500, 6000, 9000]}],
    ["record", "uc_lp", "lp", {"include_objective_constant": false}],
    ["call", "optimize", [], {"include_objective_constant": false}],
    ["record", "uc", "network"],
    ["record", "uc_lin_lp", "lp", {"include_objective_constant": false, "linearized_unit_commitment": true}],
    ["new_network"],
    ["set_snapshots", [0, 1, 2]],
    ["set_investment_periods", [2020, 2030]],
    ["add", "Bus", ["a", "b"]],
    ["add", "Carrier", ["gas", "wind"], {"co2_emissions": [0.3, 0.0]}],
    ["add", "Generator", "gas 2020", {"bus": "a", "carrier": "gas", "p_nom_extendable": true, "capital_cost": 20, "marginal_cost": 30, "build_year": 2020, "lifetime": 30}],
    ["add", "Generator", "wind 2030", {"bus": "b", "carrier": "wind", "p_nom_extendable": true, "capital_cost": 60, "build_year": 2030, "lifetime": 30, "p_max_pu": 0.4}],
    ["add", "Line", "ab", {"bus0": "a", "bus1": "b", "x": 0.1, "s_nom": 50, "s_nom_extendable": true, "capital_cost": 5}],
    ["add", "Load", "l", {"bus": "b", "p_set": 20}],
    ["add", "StorageUnit", "su", {"bus": "b", "p_nom": 5, "max_hours": 2, "cyclic_state_of_charge": true}],
    ["add", "GlobalConstraint", "co2", {"type": "primary_energy", "carrier_attribute": "co2_emissions", "sense": "<=", "constant": 1000}],
    ["set_period_weightings", "objective", [1.0, 0.5]],
    ["call", "set_scenarios", [{"s1": 0.5, "s2": 0.5}]],
    ["set_static_sc", "generators", "marginal_cost", "s2", {"gas 2020": 60}],
    ["record", "mp_lp", "lp", {"multi_investment_periods": true, "include_objective_constant": false}],
    ["call", "optimize", [], {"multi_investment_periods": true, "include_objective_constant": false}],
    ["record", "mp", "network"],
    ["record", "mp_objective", "path", ["objective"]],
    ["load_example", "ac-dc-meshed"],
    ["set_snapshots", {"$slice": [0, 3]}],
    ["call", "set_scenarios", [{"low": 0.5, "high": 0.5}]],
    ["expect_error", "err_losses_inf_s_nom_max", ["record", "losses_inf", "lp", {"transmission_losses": {"mode": "secants"}, "include_objective_constant": false}]],
    ["set_static_all", "lines", "s_nom_max", 3000],
    ["record", "losses_lp", "lp", {"transmission_losses": {"mode": "secants"}, "include_objective_constant": false}],
    ["record", "meshed_lp", "lp", {"meshed_thresholds": [3], "include_objective_constant": false}],
    ["load_example", "ac-dc-meshed"],
    ["set_snapshots", {"$slice": [0, 2]}],
    ["set_static_all", "generators", "marginal_cost_quadratic", 0.01],
    ["call", "set_scenarios", [{"low": 0.4, "high": 0.6}]],
    ["set_static_sc", "generators", "marginal_cost_quadratic", "high", {"Manchester Gas": 0.05}],
    ["record", "qp_lp", "lp", {"include_objective_constant": true}],
    ["call", "optimize", [], {"include_objective_constant": true}],
    ["record", "qp", "network"],
    ["record", "qp_objective", "path", ["objective"]],
    ["call", "set_risk_preference", [], {"alpha": 0.9, "omega": 0.5}],
    ["expect_error", "err_cvar_quadratic", ["record", "cvar_qp", "lp", {"include_objective_constant": false}]],
    ["load_example", "ac-dc-meshed"],
    ["set_snapshots", {"$slice": [0, 3]}],
    ["call", "set_scenarios", [{"low": 0.4, "high": 0.6}]],
    ["set_static_sc", "lines", "x", "high", {"2": 0.5}],
    ["set_dynamic_sc", "loads", "p_set", "high", {"London": [400, 500, 600]}],
    ["expect_error", "err_sclopf_unknown", ["call", "optimize.optimize_security_constrained", [], {"branch_outages": ["99"]}]],
    ["call", "optimize.optimize_security_constrained", [], {"branch_outages": ["0", "1", "5"], "model_kwargs": {"include_objective_constant": false}}],
    ["record", "sclopf_lp", "model_lp"],
    ["record", "sclopf", "network"],
    ["record", "sclopf_objective", "path", ["objective"]],
    ["load_example", "storage-hvdc"],
    ["set_snapshots", {"$slice": [0, 6]}],
    ["call", "set_scenarios", [{"dry": 0.5, "wet": 0.5}]],
    ["set_dynamic_sc", "storage_units", "inflow", "wet", {"Storage 0": [5, 5, 5, 5, 5, 5]}],
    ["call", "optimize.optimize_with_rolling_horizon", [], {"horizon": 3, "overlap": 1, "include_objective_constant": false}],
    ["record", "rolling", "network"]
  ]
}
