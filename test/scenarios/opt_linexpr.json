{
  "description": "linopy expression methods for custom constraints: shift, roll, diff, rolling sums (incl. centred windows), cumsum, where, groupby, isel and fillna on variables and expressions (term layout incl. -1/NaN padding) and the LP rows of constraints built from them.",
  "tolerance": {"rtol": 1e-09, "atol": 1e-09},
  "ops": [
    ["load_example", "ac-dc-meshed"],
    ["set_snapshots", {"$slice": [0, 4]}],
    ["create_model"],
    ["linexpr", "shift_var", {"var": "Generator-p"}, [["shift", [], {"snapshot": 1}]]],
    ["record", "shift_var", "result", "shift_var"],
    ["linexpr", "shift_var_neg", {"var": "Generator-p"}, [["shift", [], {"snapshot": -2}]]],
    ["record", "shift_var_neg", "result", "shift_var_neg"],
    ["linexpr", "shift_expr", {"var": "Generator-p"}, [["mul", [2]], ["add", [3]], ["shift", [], {"snapshot": 1}]]],
    ["record", "shift_expr", "result", "shift_expr"],
    ["linexpr", "shift_name", {"var": "Generator-p"}, [["shift", [], {"name": 1}]]],
    ["record", "shift_name", "result", "shift_name"],
    ["linexpr", "shift_fillna", {"var": "Generator-p"}, [["mul", [2]], ["shift", [], {"snapshot": 1}], ["fillna", [0]]]],
    ["record", "shift_fillna", "result", "shift_fillna"],
    ["linexpr", "roll_var", {"var": "Generator-p"}, [["roll", [], {"snapshot": 1}]]],
    ["record", "roll_var", "result", "roll_var"],
    ["linexpr", "roll_expr", {"var": "Generator-p"}, [["mul", [2]], ["add", [1]], ["roll", [], {"snapshot": -1}]]],
    ["record", "roll_expr", "result", "roll_expr"],
    ["linexpr", "diff_var", {"var": "Generator-p"}, [["diff", ["snapshot"]]]],
    ["record", "diff_var", "result", "diff_var"],
    ["linexpr", "diff_var2", {"var": "Generator-p"}, [["diff", ["snapshot"], {"n": 2}]]],
    ["record", "diff_var2", "result", "diff_var2"],
    ["linexpr", "diff_expr", {"var": "Generator-p"}, [["mul", [2]], ["add", [3]], ["diff", ["snapshot"]]]],
    ["record", "diff_expr", "result", "diff_expr"],
    ["linexpr", "rolling_var", {"var": "Generator-p"}, [["rolling", [], {"snapshot": 2}], ["sum"]]],
    ["record", "rolling_var", "result", "rolling_var"],
    ["linexpr", "rolling_expr", {"var": "Generator-p"}, [["mul", [2]], ["add", [1]], ["rolling", [], {"snapshot": 3}], ["sum"]]],
    ["record", "rolling_expr", "result", "rolling_expr"],
    ["linexpr", "rolling_dim", {"var": "Generator-p"}, [["rolling", [{"snapshot": 2}]], ["sum"]]],
    ["record", "rolling_dim", "result", "rolling_dim"],
    ["linexpr", "cumsum_var", {"var": "Generator-p"}, [["cumsum", ["snapshot"]]]],
    ["record", "cumsum_var", "result", "cumsum_var"],
    ["linexpr", "cumsum_expr", {"var": "Generator-p"}, [["mul", [0.5]], ["add", [1]], ["cumsum", ["snapshot"]]]],
    ["record", "cumsum_expr", "result", "cumsum_expr"],
    ["expect_error", "cumsum_all_err", ["linexpr", "e", {"var": "Line-s"}, [["cumsum"]]]],
    ["linexpr", "cumsum_1d", {"var": "Line-s_nom"}, [["cumsum"]]],
    ["record", "cumsum_1d", "result", "cumsum_1d"],
    ["linexpr", "where_var2", {"var": "Generator-p"}, [["where", [{"$da": {"dims": ["snapshot", "name"], "coords": {"name": ["Manchester Wind", "Manchester Gas", "Norway Wind", "Norway Gas", "Frankfurt Wind", "Frankfurt Gas"]}, "data": [[true, false, true, true, false, true], [true, true, false, true, true, true], [false, true, true, true, true, false], [true, true, true, false, true, true]]}}]]]],
    ["record", "where_var2", "result", "where_var2"],
    ["linexpr", "where_var1", {"var": "Generator-p"}, [["where", [{"$da": {"dims": ["name"], "coords": {"name": ["Manchester Wind", "Manchester Gas", "Norway Wind", "Norway Gas", "Frankfurt Wind", "Frankfurt Gas"]}, "data": [true, false, true, false, true, true]}}]]]],
    ["record", "where_var1", "result", "where_var1"],
    ["linexpr", "where_expr", {"var": "Generator-p"}, [["mul", [2]], ["add", [1]], ["where", [{"$da": {"dims": ["snapshot", "name"], "coords": {"name": ["Manchester Wind", "Manchester Gas", "Norway Wind", "Norway Gas", "Frankfurt Wind", "Frankfurt Gas"]}, "data": [[true, false, true, true, false, true], [true, true, false, true, true, true], [false, true, true, true, true, false], [true, true, true, false, true, true]]}}]]]],
    ["record", "where_expr", "result", "where_expr"],
    ["linexpr", "where_other", {"var": "Generator-p"}, [["mul", [2]], ["add", [1]], ["where", [{"$da": {"dims": ["name"], "coords": {"name": ["Manchester Wind", "Manchester Gas", "Norway Wind", "Norway Gas", "Frankfurt Wind", "Frankfurt Gas"]}, "data": [true, false, true, false, true, true]}}, 5]]]],
    ["record", "where_other", "result", "where_other"],
    ["linexpr", "groupby_named", {"var": "Generator-p"}, [["groupby", [{"$da": {"dims": ["name"], "coords": {"name": ["Manchester Wind", "Manchester Gas", "Norway Wind", "Norway Gas", "Frankfurt Wind", "Frankfurt Gas"]}, "data": ["Manchester", "Manchester", "Norway", "Norway", "Frankfurt", "Frankfurt"], "name": "bus"}}]], ["sum"]]],
    ["record", "groupby_named", "result", "groupby_named"],
    ["linexpr", "groupby_anon", {"var": "Generator-p"}, [["groupby", [{"$da": {"dims": ["name"], "coords": {"name": ["Manchester Wind", "Manchester Gas", "Norway Wind", "Norway Gas", "Frankfurt Wind", "Frankfurt Gas"]}, "data": ["b", "a", "b", "c", "a", "a"]}}]], ["sum"]]],
    ["record", "groupby_anon", "result", "groupby_anon"],
    ["linexpr", "groupby_expr", {"var": "Generator-p"}, [["mul", [2]], ["add", [1]], ["groupby", [{"$da": {"dims": ["name"], "coords": {"name": ["Manchester Wind", "Manchester Gas", "Norway Wind", "Norway Gas", "Frankfurt Wind", "Frankfurt Gas"]}, "data": ["Manchester", "Manchester", "Norway", "Norway", "Frankfurt", "Frankfurt"], "name": "bus"}}]], ["sum"]]],
    ["record", "groupby_expr", "result", "groupby_expr"],
    ["linexpr", "groupby_nom", {"var": "Generator-p_nom"}, [["groupby", [{"$da": {"dims": ["name"], "coords": {"name": ["Manchester Wind", "Manchester Gas", "Norway Wind", "Norway Gas", "Frankfurt Wind", "Frankfurt Gas"]}, "data": ["Manchester", "Manchester", "Norway", "Norway", "Frankfurt", "Frankfurt"], "name": "bus"}}]], ["sum"]]],
    ["record", "groupby_nom", "result", "groupby_nom"],
    ["linexpr", "groupby_frame", {"var": "Generator-p"}, [["groupby", [{"$df": {"index": ["Manchester Wind", "Manchester Gas", "Norway Wind", "Norway Gas", "Frankfurt Wind", "Frankfurt Gas"], "index_name": "name", "columns": ["bus", "kind"], "data": [["M", "w"], ["M", "g"], ["N", "w"], ["N", "g"], ["F", "w"], ["F", "g"]]}}]], ["sum"]]],
    ["record", "groupby_frame", "result", "groupby_frame"],
    ["linexpr", "groupby_frame_expr", {"var": "Generator-p"}, [["mul", [2]], ["add", [1]], ["groupby", [{"$df": {"index": ["Manchester Wind", "Manchester Gas", "Norway Wind", "Norway Gas", "Frankfurt Wind", "Frankfurt Gas"], "index_name": "name", "columns": ["bus", "kind"], "data": [["M", "w"], ["M", "g"], ["N", "w"], ["N", "g"], ["F", "w"], ["F", "g"]]}}]], ["sum"]]],
    ["record", "groupby_frame_expr", "result", "groupby_frame_expr"],
    ["linexpr", "groupby_frame_nom", {"var": "Generator-p_nom"}, [["groupby", [{"$df": {"index": ["Manchester Wind", "Manchester Gas", "Norway Wind", "Norway Gas", "Frankfurt Wind", "Frankfurt Gas"], "index_name": "name", "columns": ["bus", "kind"], "data": [["M", "w"], ["M", "g"], ["N", "w"], ["N", "g"], ["F", "w"], ["F", "g"]]}}]], ["sum"]]],
    ["record", "groupby_frame_nom", "result", "groupby_frame_nom"],
    ["linexpr", "fillna_var", {"var": "Generator-p"}, [["shift", [], {"snapshot": 1}], ["fillna", [5]]]],
    ["record", "fillna_var", "result", "fillna_var"],
    ["linexpr", "fillna_var_where", {"var": "Generator-p"}, [["where", [{"$da": {"dims": ["name"], "coords": {"name": ["Manchester Wind", "Manchester Gas", "Norway Wind", "Norway Gas", "Frankfurt Wind", "Frankfurt Gas"]}, "data": [true, false, true, false, true, true]}}]], ["fillna", [-2]]]],
    ["record", "fillna_var_where", "result", "fillna_var_where"],
    ["linexpr", "isel_var", {"var": "Generator-p"}, [["isel", [], {"snapshot": [0, 2]}]]],
    ["record", "isel_var", "result", "isel_var"],
    ["linexpr", "isel_scalar", {"var": "Generator-p"}, [["isel", [], {"snapshot": 1}]]],
    ["record", "isel_scalar", "result", "isel_scalar"],
    ["linexpr", "isel_expr", {"var": "Generator-p"}, [["mul", [2]], ["isel", [], {"name": [1, 0], "snapshot": [3]}]]],
    ["record", "isel_expr", "result", "isel_expr"],
    ["linexpr", "diff_sum", {"var": "Generator-p"}, [["diff", ["snapshot"]], ["sum", ["name"]]]],
    ["record", "diff_sum", "result", "diff_sum"],
    ["linexpr", "rolling_sum", {"var": "Generator-p"}, [["rolling", [], {"snapshot": 2}], ["sum"], ["sum", ["snapshot"]]]],
    ["record", "rolling_sum", "result", "rolling_sum"],
    ["linexpr", "rolling_center3", {"var": "Generator-p"}, [["rolling", [], {"snapshot": 3, "center": true}], ["sum"]]],
    ["record", "rolling_center3", "result", "rolling_center3"],
    ["linexpr", "rolling_center4", {"var": "Generator-p"}, [["mul", [2]], ["add", [1]], ["rolling", [{"snapshot": 4}], {"center": true}], ["sum"]]],
    ["record", "rolling_center4", "result", "rolling_center4"],
    ["linexpr", "rolling_center_map", {"var": "Generator-p"}, [["rolling", [], {"snapshot": 2, "center": {"snapshot": true}}], ["sum"]]],
    ["record", "rolling_center_map", "result", "rolling_center_map"],
    ["linexpr", "c_ramp", {"var": "Generator-p"}, [["diff", ["snapshot"]]]],
    ["expr_constraint", "c_ramp", "<=", 100, "c_ramp"],
    ["linexpr", "c_roll", {"var": "Generator-p"}, [["rolling", [], {"snapshot": 2}], ["sum"]]],
    ["expr_constraint", "c_roll", "<=", 5000, "c_roll"],
    ["linexpr", "c_where", {"var": "Generator-p"}, [["where", [{"$da": {"dims": ["snapshot", "name"], "coords": {"name": ["Manchester Wind", "Manchester Gas", "Norway Wind", "Norway Gas", "Frankfurt Wind", "Frankfurt Gas"]}, "data": [[true, false, true, true, false, true], [true, true, false, true, true, true], [false, true, true, true, true, false], [true, true, true, false, true, true]]}}]]]],
    ["expr_constraint", "c_where", ">=", 1, "c_where"],
    ["linexpr", "c_group", {"var": "Generator-p"}, [["groupby", [{"$da": {"dims": ["name"], "coords": {"name": ["Manchester Wind", "Manchester Gas", "Norway Wind", "Norway Gas", "Frankfurt Wind", "Frankfurt Gas"]}, "data": ["Manchester", "Manchester", "Norway", "Norway", "Frankfurt", "Frankfurt"], "name": "bus"}}]], ["sum"]]],
    ["expr_constraint", "c_group", "<=", 3000, "c_group"],
    ["linexpr", "c_cum", {"var": "Generator-p"}, [["cumsum", ["snapshot"]]]],
    ["expr_constraint", "c_cum", "<=", 20000, "c_cum"],
    ["linexpr", "c_shift", {"var": "Generator-p"}, [["mul", [2]], ["add", [3]], ["shift", [], {"snapshot": 1}]]],
    ["expr_constraint", "c_shift", "<=", 900, "c_shift"],
    ["record", "lp", "model_lp"],
    ["call", "optimize.solve_model"],
    ["record", "objective", "path", ["objective"]]
  ]
}
